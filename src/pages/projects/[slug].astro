---
import { projects } from "../../data/projects";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageTransition from "../../components/PageTransition.astro";
import { siteConfig } from "../../config";
import "../../styles/global.css";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const images = import.meta.glob<{ default: { src: string } }>(
  "/src/assets/covers/*.{jpeg,jpg,png,gif}",
  { eager: true },
);
const demoImages = import.meta.glob<{ default: { src: string } }>(
  "/src/assets/demos/**/*.{jpeg,jpg,png,gif}",
  { eager: true },
);
const coverSrc = images[`/${project.coverImage}`]?.default?.src || project.coverImage;
const hasScreenshots = project.screenshots && project.screenshots.length > 0;

const resolvedScreenshots = (project.screenshots || []).map((screenshot, index) => {
  const resolvedSrc = demoImages[`/${screenshot.src}`]?.default?.src || screenshot.src;
  return {
    src: resolvedSrc,
    alt: screenshot.alt,
    type: screenshot.type || "web",
    index
  };
});

const mobileScreenshots = resolvedScreenshots.filter((s) => s.type === "mobile");
const webScreenshots = resolvedScreenshots.filter((s) => s.type === "web");
---

<html lang="en" style={`--accent-color: ${siteConfig.accentColor}`}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={project.description} />
    <meta property="og:title" content={`${project.name} - ${siteConfig.name}`} />
    <meta property="og:description" content={project.description} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${project.name} - ${siteConfig.name}`} />
    <meta name="twitter:description" content={project.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{project.name} - {siteConfig.name}</title>
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <PageTransition />
    <Header />
    <main
      class="project-detail mx-auto mt-16 w-full max-w-7xl px-4 py-10 sm:px-6 md:py-16 lg:px-8"
      style={`--accent-color: ${siteConfig.accentColor}`}
    >
      <a
        href="/#projects"
        class="mb-6 inline-flex w-fit border-b border-zinc-400 text-sm leading-tight text-zinc-600 transition-colors hover:text-zinc-950 dark:border-zinc-600 dark:text-zinc-400 dark:hover:text-zinc-100"
      >
        Back to portfolio
      </a>

      <article class="ticket overflow-hidden border border-zinc-200 bg-zinc-50 shadow-2xl shadow-zinc-200/60 dark:border-zinc-800 dark:bg-zinc-900/55 dark:shadow-black/30">
        <div class="ticket-main">
          <div class="airline-strip">
            <span class="strip-mark"></span>
            <span>{project.slug}</span>
          </div>

          <div class="max-w-3xl">
            <h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              {project.name}
            </h1>
            <p class="mt-5 max-w-2xl text-lg sm:text-xl md:text-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">
              {project.tagline}
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            {project.links.live && (
              <a href={project.links.live} target="_blank" rel="noopener noreferrer" class="action action-primary">
                View live
              </a>
            )}
            {project.links.demo && (
              <a href={project.links.demo} target="_blank" rel="noopener noreferrer" class="action action-secondary">
                Watch demo
              </a>
            )}
            <a href={project.links.github} target="_blank" rel="noopener noreferrer" class="action action-secondary">
              GitHub
            </a>
          </div>

          <div class="cover-frame mt-10">
            <img src={coverSrc} alt={`${project.name} cover`} loading="eager" class="h-full w-full object-cover" />
          </div>

          <section class="ticket-section">
            <p class="field-label">Overview</p>
            <h2>What it does</h2>
            <div class="space-y-4">
              {project.overview.map((paragraph) => (
                <p class="body-copy">{paragraph}</p>
              ))}
            </div>
          </section>

          <section class="ticket-section">
            <p class="field-label">Problem and solution</p>
            <div class="problem-grid">
              <div class="info-card">
                <h3>Problem</h3>
                <p>{project.problem}</p>
              </div>
              <div class="info-card">
                <h3>Solution</h3>
                <p>{project.solution}</p>
              </div>
            </div>
          </section>

          <section class="ticket-section">
            <p class="field-label">Highlights</p>
            <ul class="highlight-list">
              {project.highlights.map((highlight, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {highlight}
                </li>
              ))}
            </ul>
          </section>

          <section class="ticket-section">
            <p class="field-label">Features</p>
            <div class="feature-grid">
              {project.features.map((feature) => (
                <div class="info-card">
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="ticket-section">
            <p class="field-label">Architecture</p>
            <div class="architecture-list">
              {project.architecture.map((item) => (
                <div class="architecture-row">
                  <span>{item.label}</span>
                  <p>{item.description}</p>
                </div>
              ))}
            </div>
          </section>

          {hasScreenshots && (
            <section class="ticket-section">
              <p class="field-label">Screenshots</p>

              {mobileScreenshots.length > 0 && (
                <div class="row-container mt-4">
                  <h3 class="row-title">Mobile</h3>
                  <div class="row">
                    {mobileScreenshots.map((shot) => (
                      <div class="thumb mobile" data-index={shot.index}>
                        <img src={shot.src} alt={shot.alt} loading="lazy" />
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {webScreenshots.length > 0 && (
                <div class="row-container mt-6">
                  <h3 class="row-title">Web</h3>
                  <div class="row">
                    {webScreenshots.map((shot) => (
                      <div class="thumb web" data-index={shot.index}>
                        <img src={shot.src} alt={shot.alt} loading="lazy" />
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}
        </div>

        <aside class="ticket-stub">
          <div class="stub-field">
            <span>Status</span>
            <strong>{project.status}</strong>
          </div>
          <div class="stub-field">
            <span>Year</span>
            <strong>{project.year}</strong>
          </div>
          <div class="stub-field">
            <span>Type</span>
            <strong>{project.type}</strong>
          </div>
          <div class="stub-field">
            <span>Stack</span>
            <div class="stack-list">
              {project.stack.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>

          <div class="barcode" aria-hidden="true"></div>
        </aside>
      </article>
    </main>
    <Footer />

    {hasScreenshots && (
      <>
        <div class="modal" id="screenshot-modal">
          <div class="modal-stage">
            <div class="modal-nav prev" id="prevBtn">&#8249;</div>
            <img id="modalImg" src="" alt="" />
            <div class="modal-nav next" id="nextBtn">&#8250;</div>
            <div class="modal-close" id="closeBtn">&#10005;</div>
            <div class="modal-counter" id="counter"></div>
          </div>
        </div>

        <script define:vars={{ screenshots: resolvedScreenshots }}>
          const modal = document.getElementById('screenshot-modal');
          const modalImg = document.getElementById('modalImg');
          const counter = document.getElementById('counter');
          let current = 0;

          function openModal(index) {
            current = index;
            render();
            modal.classList.add('open');
          }
          function render() {
            modalImg.src = screenshots[current].src;
            modalImg.alt = screenshots[current].alt;
            counter.textContent = `${current + 1} / ${screenshots.length}`;
          }
          function closeModal() {
            modal.classList.remove('open');
          }
          function next() {
            current = (current + 1) % screenshots.length;
            render();
          }
          function prev() {
            current = (current - 1 + screenshots.length) % screenshots.length;
            render();
          }

          // Add click listener to all thumbs
          document.querySelectorAll('.thumb').forEach(el => {
            el.addEventListener('click', () => {
              const idx = parseInt(el.getAttribute('data-index') || '0', 10);
              openModal(idx);
            });
          });

          const closeBtn = document.getElementById('closeBtn');
          const nextBtn = document.getElementById('nextBtn');
          const prevBtn = document.getElementById('prevBtn');

          if (closeBtn) closeBtn.addEventListener('click', closeModal);
          if (nextBtn) nextBtn.addEventListener('click', next);
          if (prevBtn) prevBtn.addEventListener('click', prev);

          if (modal) {
            modal.addEventListener('click', e => {
              if (e.target === modal) closeModal();
            });
          }

          document.addEventListener('keydown', e => {
            if (!modal || !modal.classList.contains('open')) return;
            if (e.key === 'Escape') closeModal();
            if (e.key === 'ArrowRight') next();
            if (e.key === 'ArrowLeft') prev();
          });
        </script>
      </>
    )}
  </body>
</html>

<style>
  .ticket {
    border-radius: 0.875rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    position: relative;
  }

  .ticket::before {
    border-right: 2px dashed rgb(212 212 216);
    bottom: 0;
    content: "";
    position: absolute;
    right: 18rem;
    top: 0;
    width: 0;
  }

  .dark .ticket::before {
    border-right-color: rgb(63 63 70);
  }

  .ticket-main {
    padding: clamp(1.5rem, 4vw, 3rem);
    min-width: 0;
  }

  .ticket-stub {
    background: rgb(24 24 27);
    color: rgb(244 244 245);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .dark .ticket-stub {
    background: rgb(9 9 11);
  }

  .airline-strip {
    align-items: center;
    color: rgb(82 82 91);
    display: flex;
    font-size: 0.75rem;
    font-weight: 600;
    gap: 0.75rem;
    letter-spacing: 0.08em;
    margin-bottom: 2rem;
    text-transform: uppercase;
  }

  .dark .airline-strip {
    color: rgb(161 161 170);
  }

  .strip-mark {
    background: var(--accent-color);
    border-radius: 999px;
    display: inline-flex;
    height: 0.375rem;
    width: 2.25rem;
  }

  .field-label {
    color: var(--accent-color);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .action {
    border-radius: 0.5rem;
    display: inline-flex;
    font-size: 1rem;
    font-weight: 700;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .action:hover {
    transform: translateY(-1px);
  }

  .action-primary {
    background: rgb(24 24 27);
    color: white;
  }

  .action-secondary {
    border: 1px solid rgb(161 161 170);
    color: rgb(39 39 42);
  }

  .dark .action-primary {
    background: white;
    color: rgb(24 24 27);
  }

  .dark .action-secondary {
    border-color: rgb(82 82 91);
    color: rgb(244 244 245);
  }

  .cover-frame {
    aspect-ratio: 16 / 8;
    background: rgb(228 228 231);
    border: 1px solid rgb(212 212 216);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .dark .cover-frame {
    background: rgb(39 39 42);
    border-color: rgb(63 63 70);
  }

  .ticket-section {
    border-top: 1px solid rgb(212 212 216);
    margin-top: 2.5rem;
    padding-top: 2.5rem;
  }

  .dark .ticket-section {
    border-top-color: rgb(63 63 70);
  }

  .ticket-section h2 {
    color: rgb(24 24 27);
    font-size: 1.875rem;
    font-weight: 700;
    margin: 0.75rem 0 1rem;
  }

  @media (min-width: 640px) {
    .ticket-section h2 {
      font-size: 2.25rem;
    }
  }

  .dark .ticket-section h2 {
    color: rgb(244 244 245);
  }

  .body-copy,
  .info-card p,
  .architecture-row p {
    color: rgb(82 82 91);
    font-size: 1rem;
    line-height: 1.625;
  }

  @media (min-width: 640px) {
    .body-copy,
    .info-card p,
    .architecture-row p {
      font-size: 1.125rem;
    }
  }

  .dark .body-copy,
  .dark .info-card p,
  .dark .architecture-row p {
    color: rgb(161 161 170);
  }

  .problem-grid,
  .feature-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .feature-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .info-card {
    background: white;
    border: 1px solid rgb(228 228 231);
    border-radius: 0.75rem;
    padding: 1.25rem;
  }

  .dark .info-card {
    background: rgb(24 24 27 / 0.7);
    border-color: rgb(63 63 70);
  }

  .info-card h3 {
    color: rgb(24 24 27);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 640px) {
    .info-card h3 {
      font-size: 1.5rem;
    }
  }

  .dark .info-card h3 {
    color: rgb(244 244 245);
  }

  .highlight-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .highlight-list li {
    align-items: baseline;
    background: white;
    border: 1px solid rgb(228 228 231);
    border-radius: 0.625rem;
    color: rgb(39 39 42);
    display: flex;
    gap: 0.875rem;
    line-height: 1.6;
    padding: 0.875rem 1rem;
  }

  .dark .highlight-list li {
    background: rgb(24 24 27 / 0.7);
    border-color: rgb(63 63 70);
    color: rgb(244 244 245);
  }

  .highlight-list span,
  .architecture-row span,
  .stub-field span,
  .stub-brand {
    color: var(--accent-color);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .architecture-list {
    display: grid;
    gap: 0.875rem;
    margin-top: 1rem;
  }

  .architecture-row {
    align-items: start;
    display: grid;
    gap: 1rem;
    grid-template-columns: 7rem minmax(0, 1fr);
  }

  .architecture-row span {
    background: color-mix(in srgb, var(--accent-color) 14%, white);
    border-radius: 0.375rem;
    color: rgb(24 24 27);
    padding: 0.35rem 0.65rem;
    text-align: center;
  }

  .dark .architecture-row span {
    background: color-mix(in srgb, var(--accent-color) 26%, rgb(24 24 27));
    color: rgb(244 244 245);
  }

  .row-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: rgb(113 113 122);
    margin: 1rem 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dark .row-title {
    color: rgb(161 161 170);
  }

  .row {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-color, rgb(228 228 231)) transparent;
  }

  .dark .row {
    scrollbar-color: var(--accent-color, rgb(63 63 70)) transparent;
  }

  .row::-webkit-scrollbar {
    height: 6px;
  }
  .row::-webkit-scrollbar-track {
    background: transparent;
  }
  .row::-webkit-scrollbar-thumb {
    background: var(--accent-color, rgb(228 228 231));
    border-radius: 3px;
  }
  .dark .row::-webkit-scrollbar-thumb {
    background: var(--accent-color, rgb(63 63 70));
  }

  .thumb {
    flex: 0 0 auto;
    height: 260px;
    background: white;
    border: 1px solid rgb(228 228 231);
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: transform .15s ease, border-color .15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dark .thumb {
    background: rgb(24 24 27);
    border-color: rgb(63 63 70);
  }

  .thumb:hover {
    transform: translateY(-2px);
    border-color: var(--accent-color);
  }

  .thumb img {
    height: 100%;
    width: auto;
    max-width: none;
    object-fit: contain;
    display: block;
  }

  .thumb.web img {
    width: 100%;
    height: 100%;
  }

  /* ---- Modal / carousel ---- */
  .modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 24px;
  }

  .modal.open {
    display: flex;
  }

  .modal-stage {
    position: relative;
    max-width: min(90vw, 900px);
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-stage img {
    max-width: 100%;
    max-height: 85vh;
    border-radius: 10px;
    box-shadow: 0 20px 60px rgba(0,0,0,.5);
  }

  .modal-close, .modal-nav {
    position: absolute;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.15);
    color: white;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 18px;
    user-select: none;
    transition: background .15s ease;
  }

  .modal-close:hover, .modal-nav:hover {
    background: rgba(255,255,255,.18);
  }

  .modal-close {
    top: -52px;
    right: 0;
  }

  .modal-nav.prev {
    left: -56px;
    top: 50%;
    transform: translateY(-50%);
  }

  .modal-nav.next {
    right: -56px;
    top: 50%;
    transform: translateY(-50%);
  }

  .modal-counter {
    position: absolute;
    bottom: -36px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    color: rgb(161 161 170);
  }

  .stub-code {
    color: rgb(161 161 170);
    font-size: 0.8rem;
    line-height: 1.6;
    margin-top: 0.5rem;
    overflow-wrap: anywhere;
  }

  .stub-field {
    display: grid;
    gap: 0.35rem;
  }

  .stub-field strong {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .stack-list span {
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.375rem;
    color: rgb(244 244 245);
    font-size: 0.72rem;
    line-height: 1.4;
    padding: 0.35rem 0.55rem;
  }

  .barcode {
    background: repeating-linear-gradient(
      90deg,
      rgb(244 244 245) 0 2px,
      transparent 2px 5px,
      rgb(244 244 245) 5px 6px,
      transparent 6px 11px
    );
    height: 3rem;
    margin-top: auto;
    opacity: 0.8;
  }

  @media (max-width: 980px) {
    .ticket {
      grid-template-columns: minmax(0, 1fr);
    }

    .ticket::before {
      display: none;
    }

    .ticket-stub {
      border-top: 2px dashed rgb(63 63 70);
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .project-detail {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .ticket {
      border-radius: 0.75rem;
    }

    .problem-grid {
      grid-template-columns: 1fr;
    }

    .thumb {
      height: 200px;
    }

    .modal-nav.prev {
      left: 8px;
    }

    .modal-nav.next {
      right: 8px;
    }

    .architecture-row {
      grid-template-columns: 1fr;
    }

    .cover-frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
