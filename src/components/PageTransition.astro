---
import { siteConfig } from "../config";
---

<div
  id="page-transition"
  class="page-transition"
  aria-hidden="true"
  style={`--transition-accent: ${siteConfig.accentColor}`}
>
  <div class="transition-panel">
    <div class="transition-brand">
      <span>{siteConfig.name}</span>
      <span class="transition-cursor"></span>
    </div>

    <div class="transition-lines">
      <div class="transition-line"><span>OK</span> resolving route</div>
      <div class="transition-line"><span>OK</span> preparing layout</div>
      <div class="transition-line"><span>OK</span> loading assets</div>
      <div class="transition-line"><span>OK</span> ready</div>
    </div>

    <div class="transition-progress" aria-hidden="true">
      <div class="transition-progress-fill"></div>
    </div>
  </div>
</div>

<script>
  const transition = document.getElementById("page-transition");
  const transitionLines = Array.from(document.querySelectorAll<HTMLElement>(".transition-line"));
  const transitionFill = document.querySelector<HTMLElement>(".transition-progress-fill");
  const stepDelay = 560;
  const finalDelay = 180;
  let transitionTimers: number[] = [];

  const shouldTransition = (link: HTMLAnchorElement) => {
    if (!transition) return false;
    if (link.target && link.target !== "_self") return false;
    if (link.hasAttribute("download")) return false;

    const href = link.getAttribute("href");
    if (!href || href.startsWith("mailto:") || href.startsWith("tel:")) return false;

    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin) return false;

    const samePath = url.pathname === window.location.pathname;
    const sameSearch = url.search === window.location.search;
    if (samePath && sameSearch) return false;

    return true;
  };

  const resetTransition = () => {
    transitionTimers.forEach((timer) => window.clearTimeout(timer));
    transitionTimers = [];
    transitionLines.forEach((line) => line.classList.remove("is-visible"));
    if (transitionFill) transitionFill.style.width = "0%";
  };

  const showTransition = (destination: string) => {
    const isDark = document.documentElement.classList.contains("dark");
    resetTransition();
    transition?.classList.toggle("is-dark", isDark);
    transition?.classList.add("is-active");
    document.documentElement.classList.add("is-transitioning");

    transitionLines.forEach((line, index) => {
      const timer = window.setTimeout(() => {
        line.classList.add("is-visible");
        if (transitionFill) {
          transitionFill.style.width = `${((index + 1) / transitionLines.length) * 100}%`;
        }
      }, index * stepDelay);
      transitionTimers.push(timer);
    });

    const navigationTimer = window.setTimeout(() => {
      window.location.href = destination;
    }, transitionLines.length * stepDelay + finalDelay);
    transitionTimers.push(navigationTimer);
  };

  document.addEventListener("click", (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return;
    }

    const link = (event.target as Element | null)?.closest("a");
    if (!link || !shouldTransition(link)) return;

    event.preventDefault();
    showTransition(link.href);
  });

  window.addEventListener("pageshow", () => {
    resetTransition();
    transition?.classList.remove("is-active");
    transition?.classList.toggle("is-dark", document.documentElement.classList.contains("dark"));
    document.documentElement.classList.remove("is-transitioning");
  });
</script>

<style>
  .page-transition {
    align-items: center;
    background: rgb(255 255 255 / 1);
    color: rgb(24 24 27);
    display: flex;
    inset: 0;
    justify-content: center;
    opacity: 0;
    padding: 1.5rem;
    pointer-events: none;
    position: fixed;
    transform: translateY(0.5rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
    z-index: 9999;
  }

  .dark .page-transition,
  .page-transition.is-dark {
    background: rgb(9 9 11 / 1);
    color: rgb(244 244 245);
  }

  .page-transition.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .transition-panel {
    max-width: 30rem;
    width: min(100%, 30rem);
  }

  .transition-brand {
    align-items: baseline;
    display: flex;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 700;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
  }

  .transition-cursor {
    animation: transition-blink 1s step-end infinite;
    background: var(--transition-accent);
    display: inline-flex;
    height: 1.4rem;
    width: 0.55rem;
  }

  .transition-lines {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.375rem;
    min-height: 6.5rem;
  }

  .transition-line {
    color: rgb(82 82 91);
    display: flex;
    font-size: 0.82rem;
    gap: 0.625rem;
    opacity: 0;
    transform: translateY(0.25rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .dark .transition-line,
  .page-transition.is-dark .transition-line {
    color: rgb(161 161 170);
  }

  .transition-line span {
    color: var(--transition-accent);
    font-weight: 700;
  }

  .transition-line.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .transition-progress {
    background: rgb(228 228 231);
    border-radius: 999px;
    height: 0.25rem;
    overflow: hidden;
  }

  .dark .transition-progress,
  .page-transition.is-dark .transition-progress {
    background: rgb(39 39 42);
  }

  .transition-progress-fill {
    background: var(--transition-accent);
    border-radius: inherit;
    height: 100%;
    transition: width 360ms ease;
    width: 0;
  }

  .is-transitioning {
    cursor: progress;
  }

  @keyframes transition-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-transition,
    .transition-line,
    .transition-progress-fill,
    .transition-cursor {
      animation: none;
      transition: none;
    }

    .transition-line {
      transform: none;
    }

    .transition-progress-fill {
      transition: none;
    }
  }
</style>
