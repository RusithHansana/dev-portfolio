  ---
import { siteConfig } from "../config";
---

<script is:inline>
  if (typeof sessionStorage !== "undefined" && !sessionStorage.getItem("has_seen_preloader")) {
    document.documentElement.classList.add("initial-preloader-active");
    const theme = (() => {
      if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
        return localStorage.getItem("theme");
      }
      if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
        return "dark";
      }
      return "light";
    })();
    if (theme === "dark") {
      document.documentElement.classList.add("dark");
    }
  }
</script>

<div
  id="page-transition"
  class="page-transition"
  aria-hidden="true"
  style={`--transition-accent: ${siteConfig.accentColor}`}
>
  <div class="transition-panel">
    <div class="transition-brand">
      <span>{siteConfig.name}</span>
      <span class="transition-cursor"></span>
    </div>

    <div class="transition-lines">
      <div class="transition-line"><span>OK</span> resolving route</div>
      <div class="transition-line"><span>OK</span> preparing layout</div>
      <div class="transition-line"><span>OK</span> loading assets</div>
      <div class="transition-line"><span>OK</span> ready</div>
    </div>

    <div class="transition-progress" aria-hidden="true">
      <div class="transition-progress-fill"></div>
    </div>
  </div>
</div>

<script>
  const getTransition = () => document.getElementById("page-transition");
  const getTransitionLines = () => Array.from(document.querySelectorAll<HTMLElement>(".transition-line"));
  const getTransitionFill = () => document.querySelector<HTMLElement>(".transition-progress-fill");
  let transitionTimers: number[] = [];

  const resetTransition = () => {
    transitionTimers.forEach((timer) => window.clearTimeout(timer));
    transitionTimers = [];
    const transition = getTransition();
    const transitionLines = getTransitionLines();
    const transitionFill = getTransitionFill();

    transitionLines.forEach((line) => line.classList.remove("is-visible"));
    if (transitionFill) transitionFill.style.width = "0%";
    transition?.classList.remove("is-active");
    document.documentElement.classList.remove("initial-preloader-active");
    document.documentElement.classList.remove("is-transitioning");
  };

  const playInitialPreloader = () => {
    const transition = getTransition();
    const transitionLines = getTransitionLines();
    const transitionFill = getTransitionFill();
    if (!transition) return;

    resetTransition();
    document.documentElement.classList.add("initial-preloader-active");
    const isDark = document.documentElement.classList.contains("dark");
    transition.classList.toggle("is-dark", isDark);
    transition.classList.add("is-active");
    document.documentElement.classList.add("is-transitioning");

    const stepDelay = 280;
    transitionLines.forEach((line, index) => {
      const timer = window.setTimeout(() => {
        line.classList.add("is-visible");
        if (transitionFill) {
          transitionFill.style.width = `${((index + 1) / transitionLines.length) * 100}%`;
        }
      }, index * stepDelay);
      transitionTimers.push(timer);
    });

    const completionTimer = window.setTimeout(() => {
      transition.classList.remove("is-active");
      document.documentElement.classList.remove("initial-preloader-active");
      document.documentElement.classList.remove("is-transitioning");
    }, transitionLines.length * stepDelay + 150);
    transitionTimers.push(completionTimer);
  };

  const initPreloader = () => {
    const hasSeen = sessionStorage.getItem("has_seen_preloader");
    if (!hasSeen) {
      sessionStorage.setItem("has_seen_preloader", "true");
      playInitialPreloader();
    } else {
      resetTransition();
    }
  };

  // Scrollbar visibility tracker
  const initScrollbarTracking = () => {
    let windowTimeout: number;
    const handleWindowScroll = () => {
      document.documentElement.classList.add('is-scrolling');
      window.clearTimeout(windowTimeout);
      windowTimeout = window.setTimeout(() => {
        document.documentElement.classList.remove('is-scrolling');
      }, 1000);
    };

    window.removeEventListener('scroll', handleWindowScroll);
    window.addEventListener('scroll', handleWindowScroll, { passive: true });

    const scrollableElements = document.querySelectorAll('.row');
    scrollableElements.forEach((el) => {
      let timeout: number;
      const handleElScroll = () => {
        el.classList.add('is-scrolling');
        window.clearTimeout(timeout);
        timeout = window.setTimeout(() => {
          el.classList.remove('is-scrolling');
        }, 1000);
      };
      el.removeEventListener('scroll', handleElScroll);
      el.addEventListener('scroll', handleElScroll, { passive: true });
    });
  };

  // Run initial preloader check on load
  initPreloader();
  initScrollbarTracking();

  // Handle Astro ClientRouter lifecycle
  document.addEventListener("astro:page-load", () => {
    initScrollbarTracking();
  });
</script>

<style>
  .page-transition {
    align-items: center;
    background: rgb(255 255 255 / 1);
    color: rgb(24 24 27);
    display: flex;
    inset: 0;
    justify-content: center;
    opacity: 0;
    padding: 1.5rem;
    pointer-events: none;
    position: fixed;
    transform: translateY(0.5rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
    z-index: 9999;
  }

  :global(.dark) .page-transition,
  .page-transition.is-dark {
    background: rgb(9 9 11 / 1);
    color: rgb(244 244 245);
  }

  :global(.initial-preloader-active) .page-transition,
  .page-transition.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .transition-panel {
    max-width: 30rem;
    width: min(100%, 30rem);
  }

  .transition-brand {
    align-items: baseline;
    display: flex;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 700;
    gap: 0.625rem;
    margin-bottom: 1.25rem;
  }

  .transition-cursor {
    animation: transition-blink 1s step-end infinite;
    background: var(--transition-accent);
    display: inline-flex;
    height: 1.4rem;
    width: 0.55rem;
  }

  .transition-lines {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.375rem;
    min-height: 6.5rem;
  }

  .transition-line {
    color: rgb(82 82 91);
    display: flex;
    font-size: 0.82rem;
    gap: 0.625rem;
    opacity: 0;
    transform: translateY(0.25rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  :global(.dark) .transition-line,
  .page-transition.is-dark .transition-line {
    color: rgb(161 161 170);
  }

  .transition-line span {
    color: var(--transition-accent);
    font-weight: 700;
  }

  .transition-line.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .transition-progress {
    background: rgb(228 228 231);
    border-radius: 999px;
    height: 0.25rem;
    overflow: hidden;
  }

  :global(.dark) .transition-progress,
  .page-transition.is-dark .transition-progress {
    background: rgb(39 39 42);
  }

  .transition-progress-fill {
    background: var(--transition-accent);
    border-radius: inherit;
    height: 100%;
    transition: width 360ms ease;
    width: 0;
  }

  .is-transitioning,
  .is-transitioning body {
    cursor: progress;
    overflow: hidden !important;
    scrollbar-width: none !important;
  }

  .is-transitioning::-webkit-scrollbar,
  .is-transitioning body::-webkit-scrollbar {
    display: none !important;
  }

  @keyframes transition-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-transition,
    .transition-line,
    .transition-progress-fill,
    .transition-cursor {
      animation: none;
      transition: none;
    }

    .transition-line {
      transform: none;
    }

    .transition-progress-fill {
      transition: none;
    }
  }
</style>
