---
import { siteConfig } from "../config";
import { projects } from "../data/projects";

const hasProjects = projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<footer id="footer" class="relative isolate overflow-hidden bg-zinc-950 pt-16 pb-12">
  <!-- Subtle background radial glow -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none opacity-25"
    style="background: radial-gradient(ellipse 800px 500px at 50% 0%, var(--accent-color) 0%, transparent 70%)"
  >
  </div>

  <!-- Programming Symbol / Grid SVG background pattern -->
  <div class="absolute inset-0 -z-10 overflow-hidden opacity-30 pointer-events-none">
    <svg
      aria-hidden="true"
      class="absolute bottom-0 left-0 w-full h-full stroke-zinc-800/40 [mask-image:radial-gradient(100%_100%_at_bottom_center,white,transparent)]"
    >
      <defs>
        <pattern
          id="footer-grid-pattern"
          width="80"
          height="80"
          patternUnits="userSpaceOnUse"
        >
          <path d="M.5 80V.5H80" fill="none" stroke="currentColor" stroke-width="0.5"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#footer-grid-pattern)"></rect>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-6 sm:px-10 md:px-12 xl:px-16">
    <!-- BENTO CONTACT CARD (CTA Block) -->
    <div class="mb-16 bento-card group bg-zinc-900/60 border border-zinc-800 rounded-3xl p-8 sm:p-10 md:p-12 transition-all duration-300 relative overflow-hidden">
      <!-- Spotlight border effect on hover -->
      <div
        class="spotlight-border pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100"
        aria-hidden="true"
      >
      </div>

      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- CTA Text Content -->
        <div class="lg:col-span-8 flex flex-col gap-4">
          <!-- Section Tag -->
          <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 mb-1 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--accent-color)"></span>
            // 05 / GET IN TOUCH
          </div>

          <!-- Headline -->
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-zinc-100 leading-tight">
            Let's build something <span style="color: var(--accent-color)">extraordinary</span> together.
          </h2>

          <p class="text-base sm:text-lg text-zinc-400 max-w-2xl font-mono leading-relaxed">
            Have a project in mind, an engineering role open, or want to collaborate on AI software? I'd love to connect.
          </p>

          <!-- Status badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-950/80 border border-zinc-800 text-xs font-mono text-zinc-300 w-fit mt-1">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            Available for new opportunities
          </div>
        </div>

        <!-- CTA Action Buttons & Quick Copy -->
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center items-stretch sm:items-center lg:items-end">
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="group/btn relative inline-flex items-center justify-center gap-3 px-6 py-3.5 rounded-2xl font-mono text-sm font-semibold text-zinc-950 transition-all duration-300 shadow-lg hover:shadow-lime-500/20 hover:scale-[1.02] active:scale-[0.98] w-full sm:w-auto text-center"
            style="background-color: var(--accent-color)"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5 transition-transform duration-300 group-hover/btn:-translate-y-0.5"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
              <path d="M3 7l9 6l9 -6"></path>
            </svg>
            <span>Send Email</span>
          </a>

          <button
            id="copy-email-btn"
            data-email={siteConfig.social.email}
            type="button"
            class="group/copy inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-2xl font-mono text-sm font-medium text-zinc-300 bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 hover:text-white transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] w-full sm:w-auto cursor-pointer"
          >
            <svg
              id="copy-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 text-zinc-400 group-hover/copy:text-zinc-200 transition-colors"
            >
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <svg
              id="check-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 hidden text-emerald-400"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span id="copy-btn-text">Copy Email</span>
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN FOOTER CONTENT GRID -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12">
      <!-- Brand & Bio Column -->
      <div class="md:col-span-5 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <a href="/#" class="text-2xl font-extrabold text-zinc-100 tracking-tight hover:text-white transition-colors">
            {siteConfig.name}
          </a>
          <span class="font-mono text-xs px-2.5 py-0.5 rounded-md bg-zinc-900 border border-zinc-800 text-zinc-400">
            {siteConfig.title}
          </span>
        </div>

        <p class="text-sm text-zinc-400 leading-relaxed font-mono max-w-sm">
          {siteConfig.tagline}
        </p>

        <!-- Social Media Buttons -->
        <div class="flex items-center gap-3 pt-2">
          <a
            href={`mailto:${siteConfig.social.email}`}
            aria-label="Email"
            class="p-2.5 rounded-xl bg-zinc-900/80 border border-zinc-800 text-zinc-400 transition-all duration-300 hover:border-zinc-700 hover:text-[var(--accent-color)] hover:scale-105"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
              <path d="M3 7l9 6l9 -6"></path>
            </svg>
          </a>

          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="p-2.5 rounded-xl bg-zinc-900/80 border border-zinc-800 text-zinc-400 transition-all duration-300 hover:border-zinc-700 hover:text-[var(--accent-color)] hover:scale-105"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M8 11v5"></path>
              <path d="M8 8v.01"></path>
              <path d="M12 16v-5"></path>
              <path d="M16 16v-3a2 2 0 1 0 -4 0"></path>
              <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"></path>
            </svg>
          </a>

          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="p-2.5 rounded-xl bg-zinc-900/80 border border-zinc-800 text-zinc-400 transition-all duration-300 hover:border-zinc-700 hover:text-[var(--accent-color)] hover:scale-105"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-5 h-5"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links Column -->
      <div class="md:col-span-3 flex flex-col gap-3">
        <h4 class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold mb-1">
          Navigation
        </h4>
        <ul class="flex flex-col gap-2.5 font-mono text-sm">
          <li>
            <a
              href="/#about"
              class="text-zinc-400 hover:text-zinc-100 transition-colors inline-flex items-center gap-1.5 group/nav"
            >
              <span class="text-zinc-600 group-hover/nav:text-[var(--accent-color)] transition-colors">&gt;</span>
              About
            </a>
          </li>
          {
            hasProjects && (
              <li>
                <a
                  href="/#projects"
                  class="text-zinc-400 hover:text-zinc-100 transition-colors inline-flex items-center gap-1.5 group/nav"
                >
                  <span class="text-zinc-600 group-hover/nav:text-[var(--accent-color)] transition-colors">&gt;</span>
                  Projects
                </a>
              </li>
            )
          }
          {
            hasExperience && (
              <li>
                <a
                  href="/#experience"
                  class="text-zinc-400 hover:text-zinc-100 transition-colors inline-flex items-center gap-1.5 group/nav"
                >
                  <span class="text-zinc-600 group-hover/nav:text-[var(--accent-color)] transition-colors">&gt;</span>
                  Experience
                </a>
              </li>
            )
          }
          {
            hasEducation && (
              <li>
                <a
                  href="/#education"
                  class="text-zinc-400 hover:text-zinc-100 transition-colors inline-flex items-center gap-1.5 group/nav"
                >
                  <span class="text-zinc-600 group-hover/nav:text-[var(--accent-color)] transition-colors">&gt;</span>
                  Education
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <!-- Specialties Column -->
      <div class="md:col-span-4 flex flex-col gap-3">
        <h4 class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold mb-1">
          Specialties
        </h4>
        <div class="flex flex-wrap gap-2">
          {siteConfig.specialties?.map((spec) => (
            <span class="font-mono text-xs px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-300">
              {spec}
            </span>
          ))}
          {siteConfig.skills?.slice(0, 4).map((skill) => (
            <span class="font-mono text-xs px-3 py-1 rounded-full bg-zinc-950 border border-zinc-800/80 text-zinc-400">
              {skill}
            </span>
          ))}
        </div>

        <div class="mt-4 pt-2">
          <button
            id="back-to-top-btn"
            type="button"
            class="group/top inline-flex items-center gap-2 font-mono text-xs text-zinc-400 hover:text-zinc-100 px-4 py-2.5 rounded-xl bg-zinc-900/80 border border-zinc-800 hover:border-zinc-700 transition-all duration-300 cursor-pointer"
          >
            <span>Back to top</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4 text-zinc-500 group-hover/top:text-[var(--accent-color)] group-hover/top:-translate-y-0.5 transition-all"
            >
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- BOTTOM META BAR -->
    <div class="pt-8 border-t border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-zinc-500">
      <div class="flex items-center gap-2">
        <span>© {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</span>
      </div>

      <div class="flex items-center gap-4">
        <span>Built with <span class="text-zinc-400">Astro</span> & <span class="text-zinc-400">Tailwind CSS</span></span>
        <span class="text-zinc-700">•</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-400/90">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          SYS_OK
        </span>
      </div>
    </div>
  </div>
</footer>

<script>
  function setupFooterInteractions() {
    // Copy Email functionality
    const copyBtn = document.getElementById("copy-email-btn");
    if (copyBtn && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = "true";
      copyBtn.addEventListener("click", async () => {
        const email = copyBtn.getAttribute("data-email");
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          const copyIcon = document.getElementById("copy-icon");
          const checkIcon = document.getElementById("check-icon");
          const textSpan = document.getElementById("copy-btn-text");

          if (copyIcon && checkIcon && textSpan) {
            copyIcon.classList.add("hidden");
            checkIcon.classList.remove("hidden");
            textSpan.textContent = "Copied!";

            setTimeout(() => {
              copyIcon.classList.remove("hidden");
              checkIcon.classList.add("hidden");
              textSpan.textContent = "Copy Email";
            }, 2500);
          }
        } catch (err) {
          console.error("Failed to copy email:", err);
        }
      });
    }

    // Back to Top functionality
    const backToTopBtn = document.getElementById("back-to-top-btn");
    if (backToTopBtn && !backToTopBtn.dataset.bound) {
      backToTopBtn.dataset.bound = "true";
      backToTopBtn.addEventListener("click", () => {
        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });
      });
    }
  }

  setupFooterInteractions();
  document.addEventListener("astro:page-load", setupFooterInteractions);
</script>
