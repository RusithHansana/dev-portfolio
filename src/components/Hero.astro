---
import { siteConfig } from "../config";
import heroImage from "../assets/hero/hero-image.jpeg";

interface Props {
  photoUrl?: string;
}

const { photoUrl } = Astro.props;
const displayPhotoSrc = photoUrl || siteConfig.photoUrl || heroImage.src;

const nameParts = siteConfig.name.split(" ");
const firstName = nameParts[0] || "Rusith";
const lastName = nameParts.slice(1).join(" ") || "Hansana";

const featuredSkills = siteConfig.skills?.slice(0, 5) || [
  "TypeScript",
  "React",
  "Node.js",
  "PostgreSQL",
  "Next.js",
];
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-zinc-950 min-h-screen py-20 sm:py-24 xl:py-0 xl:h-screen flex items-center"
>
  <!-- Gradient overlay -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none"
    style="background: radial-gradient(ellipse 800px 1200px at 0% 0%, var(--accent-color) 0%, transparent 40%, rgba(9, 9, 11, 0.3) 70%, rgba(9, 9, 11, 1) 100%)"
  >
  </div>
  
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-zinc-200 dark:stroke-zinc-800 [mask-image:radial-gradient(100%_100%_at_top_right,white,transparent)] pointer-events-none"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="0787a7c5-hero"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
      <pattern
        id="programming-symbols-hero"
        x="0"
        y="0"
        width="400"
        height="400"
        patternUnits="userSpaceOnUse"
      >
        <text
          x="50"
          y="50"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="24"
          transform="rotate(-15)">&lt;/&gt;</text
        >
        <text
          x="150"
          y="100"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="20"
          transform="rotate(10)">{}</text
        >
        <text
          x="250"
          y="80"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="18"
          transform="rotate(-5)">=&gt;</text
        >
        <text
          x="100"
          y="200"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="22"
          transform="rotate(15)">[]</text
        >
        <text
          x="300"
          y="180"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="20"
          transform="rotate(-10)">&lt;&gt;</text
        >
        <text
          x="200"
          y="250"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="24"
          transform="rotate(5)">()</text
        >
        <text
          x="50"
          y="320"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="18"
          transform="rotate(-8)">::</text
        >
        <text
          x="350"
          y="300"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="22"
          transform="rotate(12)">==</text
        >
        <text
          x="150"
          y="350"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="20"
          transform="rotate(-15)">++</text
        >
        <text
          x="250"
          y="370"
          fill="var(--accent-color)"
          font-family="monospace"
          font-size="24"
          transform="rotate(8)">;</text
        >
      </pattern>
    </defs>
    <rect
      fill="url(#programming-symbols-hero)"
      width="100%"
      height="100%"
      opacity="0.2"></rect>
    <rect
      fill="url(#0787a7c5-hero)"
      width="100%"
      height="100%"
      stroke-width={0}></rect>
  </svg>

  <div class="w-full p-6 sm:p-10 md:p-12 xl:p-16 flex items-center my-auto">
    <div class="w-full grid grid-cols-1 md:grid-cols-2 xl:grid-cols-[0.85fr_1.3fr_1fr] gap-6 xl:gap-8 items-stretch">
      <!-- Photo Card -->
      <div class="bento-card group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-3xl relative overflow-hidden min-h-[320px] sm:min-h-[380px] xl:min-h-[440px] flex flex-col justify-between p-6 sm:p-8 transition-all duration-300">
        <div class="spotlight-border pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
        {displayPhotoSrc ? (
          <img
            src={displayPhotoSrc}
            alt={siteConfig.name}
            class="absolute inset-0 w-full h-full object-cover object-center grayscale-[30%] opacity-90 transition-all duration-700 ease-out group-hover:grayscale-0 group-hover:opacity-100"
          />
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-zinc-200/80 via-zinc-100 to-zinc-200/50 dark:from-zinc-900 dark:via-zinc-950 dark:to-zinc-900/90 flex items-center justify-center">
            <svg class="w-24 h-24 text-zinc-400 dark:text-zinc-700 transition-transform duration-500 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
            </svg>
          </div>
        )}
        <div class="photo-shine pointer-events-none" aria-hidden="true"></div>
      </div>

      <!-- Main Card -->
      <div class="bento-card group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 xl:p-10 flex flex-col justify-between transition-all duration-300 relative overflow-hidden h-full">
        <div class="spotlight-border pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
        
        <div class="relative z-10 flex flex-col justify-between h-full">
          <div>
            <!-- Top Bar -->
            <div class="flex items-center justify-between mb-6">
              <span class="font-mono text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full" style="background-color: var(--accent-color)"></span>
                00 / INTRODUCTION
              </span>
              <span class="font-mono text-xs px-3 py-1 rounded-full bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-700 dark:text-zinc-300 shadow-2xs">
                // OVERVIEW
              </span>
            </div>

            <!-- Content -->
            <div class="font-mono text-xs sm:text-sm uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-2">
              Hello, I'm
            </div>
            <h1 class="text-3xl sm:text-4xl xl:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100 leading-tight mb-4">
              {firstName} <span style={{ color: "var(--accent-color)" }}>{lastName}</span>
            </h1>
            <p class="font-mono text-sm sm:text-base text-zinc-600 dark:text-zinc-300 mb-6 leading-relaxed">
              {siteConfig.tagline}
            </p>
          </div>

          <!-- Bottom Footer Bar -->
          <div class="mt-8 pt-6 border-t border-zinc-200 dark:border-zinc-800/80 flex flex-wrap items-center justify-between gap-4">
            <!-- Socials -->
            <div class="flex items-center gap-3">
              {siteConfig.social?.email && (
                <a
                  href={`mailto:${siteConfig.social.email}`}
                  aria-label="Email"
                  class="w-10 h-10 rounded-xl bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:text-white hover:bg-[var(--accent-color)] hover:border-[var(--accent-color)] transition-all duration-300 shadow-2xs"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
                  </svg>
                </a>
              )}
              {siteConfig.social?.linkedin && (
                <a
                  href={siteConfig.social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="LinkedIn"
                  class="w-10 h-10 rounded-xl bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:text-white hover:bg-[var(--accent-color)] hover:border-[var(--accent-color)] transition-all duration-300 shadow-2xs"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="3"/><line x1="8" y1="10" x2="8" y2="17"/><circle cx="8" cy="7" r="1"/><path d="M12 17v-4a2 2 0 0 1 4 0v4"/>
                  </svg>
                </a>
              )}
              {siteConfig.social?.github && (
                <a
                  href={siteConfig.social.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="GitHub"
                  class="w-10 h-10 rounded-xl bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:text-white hover:bg-[var(--accent-color)] hover:border-[var(--accent-color)] transition-all duration-300 shadow-2xs"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2-.2 4-1 4-4.5 0-1-.4-2-1-2.7.1-.3.4-1.4-.1-2.8 0 0-1-.3-3 1a10 10 0 0 0-5 0c-2-1.3-3-1-3-1-.5 1.4-.2 2.5-.1 2.8A4 4 0 0 0 4 9.9c0 3.5 2 4.3 4 4.5-.3.3-.5.9-.5 1.7V19"/>
                  </svg>
                </a>
              )}
            </div>

            <div class="flex items-center gap-2 font-mono text-xs text-zinc-400 dark:text-zinc-500">
              <span>Based in Sri Lanka</span>
              <span class="text-[var(--accent-color)]">•</span>
              <span class="text-[var(--accent-color)] font-medium">Available Globally</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Side Column -->
      <div class="flex flex-col md:col-span-2 xl:col-span-1 md:flex-row xl:flex-col gap-6 xl:gap-8">
        <!-- Status Card -->
        <div class="bento-card group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 xl:p-10 flex-1 flex flex-col justify-between transition-all duration-300 relative overflow-hidden h-full">
          <div class="spotlight-border pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
          
          <div class="relative z-10 flex flex-col justify-between h-full">
            <div>
              <!-- Top Bar -->
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
                  // CURRENT AVAILABILITY
                </span>
                <span class="font-mono text-xs px-3 py-1 rounded-full bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-700 dark:text-zinc-300 shadow-2xs">
                  ACTIVE
                </span>
              </div>

              <!-- Main Status Content -->
              <div class="flex items-center gap-3 text-base sm:text-lg font-semibold text-zinc-800 dark:text-zinc-200 my-4">
                <span class="relative flex h-3.5 w-3.5 shrink-0">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-emerald-500"></span>
                </span>
                Available for new projects
              </div>
            </div>

            <!-- Footer Tag -->
            <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-zinc-800/80 flex items-center justify-between font-mono text-xs text-zinc-400 dark:text-zinc-500">
              <span>Work Status</span>
              <span class="text-[var(--accent-color)] font-medium">Open to Offers</span>
            </div>
          </div>
        </div>

        <!-- Skills Card -->
        <div class="bento-card group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 xl:p-10 flex-1 flex flex-col justify-between transition-all duration-300 relative overflow-hidden h-full">
          <div class="spotlight-border pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
          
          <div class="relative z-10 flex flex-col justify-between h-full">
            <div>
              <!-- Top Bar -->
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
                  // TECH ARSENAL
                </span>
                <span class="font-mono text-xs px-3 py-1 rounded-full bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-700 dark:text-zinc-300 shadow-2xs">
                  CORE STACK
                </span>
              </div>

              <!-- Skills List -->
              <div class="flex flex-wrap gap-2.5 my-2">
                {featuredSkills.map((skill, index) => (
                  <div
                    class="font-mono text-xs sm:text-sm px-3.5 py-2 rounded-2xl bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/80 text-zinc-800 dark:text-zinc-200 shadow-xs hover:border-[var(--accent-color)] hover:text-zinc-900 dark:hover:text-white transition-all duration-200 flex items-center gap-2 group/skill animate-rise"
                    style={`animation-delay: ${index * 0.08}s`}
                  >
                    <span class="w-1.5 h-1.5 rounded-full transition-transform duration-300 group-hover/skill:scale-125" style="background-color: var(--accent-color)"></span>
                    <span>{skill}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Footer Tag -->
            <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-zinc-800/80 flex items-center justify-between font-mono text-xs text-zinc-400 dark:text-zinc-500">
              <span>Primary Tech</span>
              <span class="text-[var(--accent-color)] font-medium">Production Ready</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .bento-card {
    --mouse-x: 50%;
    --mouse-y: 50%;
  }

  .spotlight-border {
    background: radial-gradient(
      450px circle at var(--mouse-x) var(--mouse-y),
      var(--accent-color, #84cc16),
      transparent 70%
    );
    -webkit-mask: 
      linear-gradient(#fff 0 0) content-box, 
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    padding: 1.5px;
    border-radius: inherit;
    z-index: 5;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-rise {
    animation: rise 0.4s ease forwards;
  }

  .photo-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.25) 45%,
      rgba(255, 255, 255, 0.45) 50%,
      rgba(255, 255, 255, 0.25) 55%,
      transparent 80%
    );
    transform: translateX(-150%) skewX(-15deg);
    transition: transform 0.85s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 5;
  }

  .group:hover .photo-shine {
    transform: translateX(150%) skewX(-15deg);
  }
</style>

<script>
  function initBentoSpotlight() {
    const cards = document.querySelectorAll<HTMLElement>('.bento-card');
    cards.forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  }

  initBentoSpotlight();
  document.addEventListener('astro:page-load', initBentoSpotlight);
</script>
