---
import { siteConfig } from "../config";
import { projects } from "../data/projects";
const hasProjects = projects.length > 0;

const images = import.meta.glob<{ default: { src: string } }>('/src/assets/covers/*.{jpeg,jpg,png,gif}', { eager: true });
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4 lg:top-8">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-zinc-900 dark:text-zinc-100">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style="background-color: var(--accent-color)"
            />
          </div>

          <div class="lg:col-span-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
              {projects.map((project, index) => {
                const Component = project.slug ? "a" : "div";
                const linkProps = project.slug
                  ? {
                      href: `/projects/${project.slug}`,
                    }
                  : {};

                return (
                  <div class={`project-card-wrap relative w-full rounded-xl sm:rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900 overflow-hidden shadow-sm transition-all duration-300 ${project.slug ? 'is-linked' : ''}`}>
                    <Component
                      {...linkProps}
                      class="project-card block relative w-full text-inherit no-underline"
                    >
                      {/* Cover photo */}
                      <div class="project-cover relative w-full overflow-hidden bg-zinc-200 dark:bg-zinc-800">
                        <img
                          src={images[`/${project.coverImage}`]?.default?.src || project.coverImage}
                          alt={project.name}
                          loading="lazy"
                          class="w-full h-auto block object-cover"
                        />
                      </div>

                      {/* Desktop hover overlay panel */}
                      <div class="project-panel hidden md:flex flex-col justify-between">
                        <div class="space-y-3">
                          <div class="flex items-start justify-between gap-3">
                            <div>
                              <span
                                class="text-xs sm:text-sm font-mono font-semibold block"
                                style={{ color: "var(--accent-color)" }}
                              >
                                0{index + 1}
                              </span>
                              <h3 class="text-xl sm:text-2xl font-bold text-white mt-0.5">
                                {project.name}
                              </h3>
                            </div>

                            {project.slug && (
                              <div class="project-cover-arrow">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/>
                                </svg>
                              </div>
                            )}
                          </div>

                          <p class="text-sm sm:text-base text-zinc-200/90 leading-relaxed">
                            {project.description}
                          </p>
                        </div>

                        {project.stack && project.stack.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-4">
                            {project.stack.map((skill) => (
                              <span class="px-2.5 py-1 bg-white/15 border border-white/20 text-white rounded-md text-xs font-medium backdrop-blur-xs">
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .project-card-wrap.is-linked:hover,
  .project-card-wrap.is-linked:focus-within {
    border-color: var(--zinc-300, #d4d4d8);
  }
  :global(.dark) .project-card-wrap.is-linked:hover,
  :global(.dark) .project-card-wrap.is-linked:focus-within {
    border-color: var(--zinc-700, #3f3f46);
  }

  /* Only show and animate panel on devices supporting hover */
  @media (hover: hover) {
    .project-panel {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: 1.25rem;
      background: rgba(24, 24, 27, 0.88);
      -webkit-backdrop-filter: blur(16px) saturate(160%);
      backdrop-filter: blur(16px) saturate(160%);
      color: #ffffff;
      transform: translateY(100%);
      opacity: 0;
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
      z-index: 10;
    }
    @media (min-width: 640px) {
      .project-panel {
        padding: 1.75rem;
      }
    }

    .project-card-wrap:hover .project-panel,
    .project-card-wrap:focus-within .project-panel {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (hover: none) {
    .project-panel {
      display: none !important;
    }
  }

  .project-cover-arrow {
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 9999px;
    color: #ffffff;
    transition: background-color 0.3s, transform 0.3s;
  }
  .project-card-wrap.is-linked:hover .project-cover-arrow {
    background: var(--accent-color, #84cc16);
    transform: translate(0.125rem, -0.125rem);
  }
</style>


