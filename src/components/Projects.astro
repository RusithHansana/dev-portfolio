---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

const images = import.meta.glob<{ default: { src: string } }>('/src/assets/covers/*.{jpeg,jpg,png,gif}', { eager: true });
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-zinc-900 dark:text-zinc-100">
              Projects
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.projects.map((project, index) => {
                const Component = project.slug ? "a" : "div";
                const linkProps = project.slug
                  ? {
                      href: `/projects/${project.slug}`,
                    }
                  : {};

                return (
                  <div class="group relative">
                    <Component
                      {...linkProps}
                      class={`flex flex-col relative bg-zinc-50 dark:bg-zinc-900/50 rounded-xl sm:rounded-2xl border border-zinc-200 dark:border-zinc-800 overflow-hidden transition-all duration-300 ${
                        project.slug
                          ? "hover:bg-white dark:hover:bg-zinc-800 hover:shadow-xl hover:border-zinc-300 dark:hover:border-zinc-700 hover:-translate-y-1"
                          : ""
                      }`}
                    >
                      {/* Cover photo — required for every project */}
                      <div class="relative w-full h-[220px] sm:h-[260px] overflow-hidden bg-zinc-200 dark:bg-zinc-800">
                        <img
                          src={images[`/${project.coverImage}`]?.default?.src || project.coverImage}
                          alt={project.name}
                          loading="lazy"
                          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.06]"
                        />

                        {project.slug && (
                          <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 flex items-center justify-center bg-zinc-900/85 backdrop-blur-sm rounded-full text-white transition-all duration-300 group-hover:bg-zinc-900">
                            <svg
                              class="w-4 h-4 sm:w-4.5 sm:h-4.5 md:w-5 md:h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M7 17L17 7M17 7H7M17 7V17"
                              />
                            </svg>
                          </div>
                        )}
                      </div>

                      {/* Card body */}
                      <div class="p-4 sm:p-6 md:p-8 space-y-4">
                        <div>
                          <span
                            class="text-sm font-mono"
                            style={{ color: siteConfig.accentColor }}
                          >
                            0{index + 1}
                          </span>
                          <h3 class="text-xl sm:text-2xl font-bold text-zinc-900 dark:text-zinc-100 mt-1">
                            {project.name}
                          </h3>
                        </div>

                        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
                          {project.description}
                        </p>

                        {project.skills && project.skills.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-2">
                            {project.skills.map((skill) => (
                              <span
                                class={`px-2.5 sm:px-3 py-1 sm:py-1.5 bg-zinc-900 dark:bg-zinc-800 text-white dark:text-zinc-200 rounded-md sm:rounded-lg text-xs sm:text-sm font-medium transition-all duration-300 ${
                                  project.slug ? "group-hover:bg-zinc-800 dark:group-hover:bg-zinc-700" : ""
                                }`}
                              >
                                {skill}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </Component>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
