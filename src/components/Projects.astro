---
import { siteConfig } from "../config";
import { projects } from "../data/projects";
const hasProjects = projects.length > 0;

const images = import.meta.glob<{ default: { src: string } }>('/src/assets/covers/*.{jpeg,jpg,png,gif}', { eager: true });

// Column spans for asymmetric bento grid layout
const colSpans = [
  "lg:col-span-7 xl:col-span-8",
  "lg:col-span-5 xl:col-span-4",
  "lg:col-span-5 xl:col-span-4",
  "lg:col-span-7 xl:col-span-8",
];
---

{
  hasProjects && (
    <section id="projects" class="relative isolate overflow-hidden py-16 sm:py-24 border-t border-zinc-200/50 dark:border-zinc-800/60">
      <!-- Gradient overlay -->
      <div
        class="absolute inset-0 -z-10 pointer-events-none opacity-30 dark:opacity-20"
        style="background: radial-gradient(ellipse 600px 600px at 0% 50%, var(--accent-color) 0%, transparent 60%)"
      >
      </div>

      <div class="max-w-7xl mx-auto px-6 sm:px-10 md:px-12 xl:px-16">
        <!-- Section Header -->
        <div class="mb-10 sm:mb-12">
          <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full" style="background-color: var(--accent-color)"></span>
            02 / FEATURED WORK
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100">
            Selected <span style="color: var(--accent-color)">Projects</span>
          </h2>
        </div>

        <!-- Bento Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6 xl:gap-8 items-stretch">
          {projects.map((project, index) => {
            const coverSrc = images[`/${project.coverImage}`]?.default?.src || project.coverImage;
            const spanClass = colSpans[index % colSpans.length] || "lg:col-span-6";

            return (
              <div class={`${spanClass} bento-card group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 relative overflow-hidden h-full`}>
                <div class="spotlight-border pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>

                <div class="flex flex-col h-full">
                  {/* Top Bar */}
                  <div class="flex items-center justify-between font-mono text-xs text-zinc-400 dark:text-zinc-500 mb-4 relative z-10">
                    <span class="uppercase tracking-widest">
                      0{index + 1} // {project.type}
                    </span>
                    <span class="px-3 py-1 rounded-full bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-700 dark:text-zinc-300">
                      {project.year}
                    </span>
                  </div>

                  {/* Cover Image */}
                  <div class="relative w-full rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800/80 mb-6 bg-zinc-950 aspect-[16/9] group/img relative z-10">
                    {project.slug ? (
                      <a href={`/projects/${project.slug}`} class="block w-full h-full">
                        <img
                          src={coverSrc}
                          alt={project.name}
                          loading="lazy"
                          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent opacity-60"></div>
                      </a>
                    ) : (
                      <>
                        <img
                          src={coverSrc}
                          alt={project.name}
                          loading="lazy"
                          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/70 via-transparent to-transparent opacity-60"></div>
                      </>
                    )}
                  </div>

                  {/* Content Area */}
                  <div class="flex flex-col flex-1 justify-between relative z-10">
                    <div>
                      <div class="flex items-center justify-between gap-4 mb-3">
                        <h3 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 group-hover:text-[var(--accent-color)] transition-colors">
                          {project.slug ? (
                            <a href={`/projects/${project.slug}`} class="hover:underline">
                              {project.name}
                            </a>
                          ) : (
                            project.name
                          )}
                        </h3>

                        {project.slug && (
                          <a
                            href={`/projects/${project.slug}`}
                            aria-label={`View ${project.name} details`}
                            class="w-10 h-10 rounded-2xl bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-700 dark:text-zinc-300 group-hover:bg-[var(--accent-color)] group-hover:text-white group-hover:border-[var(--accent-color)] transition-all duration-300 shrink-0 shadow-2xs"
                          >
                            <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M7 17L17 7M17 7H7M17 7V17"/>
                            </svg>
                          </a>
                        )}
                      </div>

                      <p class="font-mono text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-6 leading-relaxed">
                        {project.tagline}
                      </p>
                    </div>

                    {/* Stack Badges */}
                    {project.stack && project.stack.length > 0 && (
                      <div class="flex flex-wrap gap-2 pt-2">
                        {project.stack.slice(0, 5).map((skill) => (
                          <span class="font-mono text-xs px-3 py-1 rounded-xl bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-700 dark:text-zinc-300 shadow-2xs">
                            {skill}
                          </span>
                        ))}
                        {project.stack.length > 5 && (
                          <span class="font-mono text-xs px-2.5 py-1 rounded-xl bg-zinc-200/50 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400">
                            +{project.stack.length - 5}
                          </span>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )
}
