---
import { siteConfig } from "../config";
---

<section id="about" class="relative isolate overflow-hidden py-16 sm:py-24 border-t border-zinc-800/80">
  <!-- Subtle background glow -->
  <div
    class="absolute inset-0 -z-10 pointer-events-none opacity-30 dark:opacity-20"
    style="background: radial-gradient(ellipse 600px 600px at 100% 50%, var(--accent-color) 0%, transparent 60%)"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 sm:px-10 md:px-12 xl:px-16">
    <!-- Section Header -->
    <div class="mb-10 sm:mb-12">
      <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-3 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full" style="background-color: var(--accent-color)"></span>
        01 / ABOUT ME
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-100">
        Engineered for <span style="color: var(--accent-color)">impact</span>
      </h2>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 xl:gap-8 items-stretch">
      <!-- Main Bio Card -->
      <div class="lg:col-span-7 bento-card group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 xl:p-10 flex flex-col justify-between transition-all duration-300 relative overflow-hidden h-full">
        <div class="spotlight-border pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
        
        <div>
          <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-4 relative z-10 flex items-center gap-2">
            // BACKGROUND & PHILOSOPHY
          </div>
          <p class="font-mono text-sm sm:text-base md:text-lg text-zinc-600 dark:text-zinc-300 leading-relaxed relative z-10">
            {siteConfig.aboutMe}
          </p>
        </div>

        <div class="mt-8 pt-6 border-t border-zinc-200 dark:border-zinc-800/80 flex flex-wrap items-center justify-between gap-3 relative z-10">
          <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
            Based in Sri Lanka • Available Globally
          </span>
          <span class="font-mono text-xs px-3 py-1 rounded-full bg-zinc-200/80 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300">
            Full-Cycle Engineering
          </span>
        </div>
      </div>

      <!-- Tech Stack Bento Card -->
      <div class="lg:col-span-5 bento-card group bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 xl:p-10 flex flex-col justify-between transition-all duration-300 relative overflow-hidden h-full">
        <div class="spotlight-border pointer-events-none absolute -inset-px rounded-3xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
        
        <div>
          <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 dark:text-zinc-500 mb-6 relative z-10">
            // TECH ARSENAL & FRAMEWORKS
          </div>

          <div class="flex flex-wrap gap-2.5 relative z-10">
            {siteConfig.skills.map((skill) => (
              <div
                class="font-mono text-xs sm:text-sm px-3.5 py-2 rounded-2xl bg-white dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700/80 text-zinc-800 dark:text-zinc-200 shadow-xs hover:border-[var(--accent-color)] hover:text-zinc-900 dark:hover:text-white transition-all duration-200 flex items-center gap-2 group/skill"
              >
                <span class="w-1.5 h-1.5 rounded-full transition-transform duration-300 group-hover/skill:scale-125" style="background-color: var(--accent-color)"></span>
                <span>{skill}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-8 pt-4 border-t border-zinc-200 dark:border-zinc-800/80 flex items-center justify-between font-mono text-xs text-zinc-400 dark:text-zinc-500 relative z-10">
          <span>Continuous Learning</span>
          <span class="text-[var(--accent-color)] font-medium">100% Focused</span>
        </div>
      </div>
    </div>
  </div>
</section>
